{
  "name": "storskegg.github.io",
  "version": "2.0.0",
  "private": true,
  "description": "My Resume",
  "scripts": {
    "build": "sass --style=compressed --no-source-map scss/resume.scss css/resume.css",
    "watch": "sass --watch --style=compressed --no-source-map scss/resume.scss css/resume.css",
    "serve": "browser-sync start --server --files 'index.html,css/*.css,img/*' --no-open --no-notify",
    "dev": "npm run build && (npm run watch & npm run serve)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/storskegg/storskegg.github.io.git"
  },
  "author": "Liam Conrad",
  "license": "ISC",
  "engines": {
    "node": ">=26"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "sass": "^1.108.2"
  }
}
